# Copie para .env.local e preencha. Na Vercel, as mesmas variáveis vão em
# Settings → Environment Variables (Production, Preview e Development).

# ── Supabase (Settings → API) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ignora RLS. Só servidor: nunca em componente "use client".
SUPABASE_SERVICE_ROLE_KEY=

# ── Endereço público do app ─────────────────────────────────────
# Usado nos links de convite e nos e-mails. Sem ele cai em
# https://ctatitudevital.com.br.
NEXT_PUBLIC_SITE_URL=https://ctatitudevital.com.br

# ── Push (npx web-push generate-vapid-keys) ─────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@ctatitudevital.com.br

# ── Cron e entrega de notificações ──────────────────────────────
# Qualquer texto longo e aleatório (openssl rand -hex 32). A Vercel manda
# no cron; o banco guarda uma cópia no Vault (notificacoes_segredo).
CRON_SECRET=

# ── E-mail (Resend, domínio envio.ctatitudevital.com.br) ────────
# Chave "Sending access" restrita ao domínio.
RESEND_API_KEY=

# ── Só para os scripts de scripts/ (não vai para a Vercel) ──────
# Token pessoal da conta Supabase (Account → Access Tokens). Pode deixar
# no ambiente do terminal em vez de aqui.
# SUPABASE_ACCESS_TOKEN=
